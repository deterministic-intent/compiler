{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "REQ v1 (REQ.json)",
  "additionalProperties": false,
  "required": ["schema_version", "intents"],
  "properties": {
    "schema_version": { "const": "req_v1" },
    "kind": { "type": "string" },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_type", "params"],
        "properties": {
          "intent_type": { "type": "string" },
          "intent_id": { "type": "string" },
          "params": { "type": "object" },
          "module_refs": { "type": "array" },
          "artifact_class": { "type": "string" },
          "language": { "type": "string" }
        }
      }
    }
  }
}
