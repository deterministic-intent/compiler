# Example environment for DCS/NLC local development.
#
# DO NOT commit real secrets into `.env`.
# `.env` is intentionally ignored by git; use this file as a template.

# --- Snapshot pins (required for deterministic runs) ---
NLC_DB_SNAPSHOT_ID=20260103T060637Z
NLC_SNAPSHOT_ID=20260103T060637Z
NLC_KB_SNAPSHOT_ID=20260103T060637Z

# --- Policy ---
NLC_POLICY_VERSION=v1

# --- Replay / determinism clamps ---
# DCS_REPRO=1  # Repro/replay mode (NLC_REPRO=1 is legacy alias)

# --- External snapshot capture/replay (Step 9+) ---
# NLC_EXTERNAL_SNAPSHOT_ID=20260103T000000Z
# NLC_EXTERNAL_REPLAY=1
